# Google OAuth credentials (download from Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Ollama model to use
OLLAMA_MODEL=mistral
OLLAMA_HOST=http://localhost:11434

# LuxTTS — path to the LuxTTS repo and your reference voice WAV
LUXTTS_PATH=/home/user/LuxTTS
VOICE_REFERENCE_WAV=/home/user/LuxTTS/audio_file.wav

# LuxTTS tuning (optional)
LUXTTS_REF_DURATION=28   # seconds of reference audio to use
LUXTTS_RMS=50            # volume normalization
LUXTTS_NUM_STEPS=4       # 4=fast, 8=better quality
LUXTTS_T_SHIFT=0.9       # controls expressiveness (0.5-1.0)
LUXTTS_SPEED=1.0         # speech speed multiplier

# Whisper model size: tiny, base, small, medium
WHISPER_MODEL=small

# Chrome profile to use for joining meetings
CHROME_PROFILE_DIR=/home/user/.config/google-chrome
CHROME_PROFILE_NAME=Default
CHROME_BINARY=/usr/bin/google-chrome

# Join this many seconds BEFORE the scheduled meeting start (0 = exactly on time)
JOIN_EARLY_SEC=0

# How long to wait before speaking (silence detection seconds)
SILENCE_THRESHOLD_SEC=1.5

# Bot persona prompt
BOT_PERSONA=You are attending this Google Meet on behalf of the user. Be concise. Only respond when directly addressed or when you have something important to contribute. Keep responses under 3 sentences.
