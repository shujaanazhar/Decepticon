# Copy to .env and fill in. .env is gitignored — never commit real values.

# ─── Which backend attends your meetings ─────────────────────────────────────
#
#   local     Everything on this machine. Joins via Chrome, transcribes with
#             Whisper, thinks with Ollama, and SPEAKS in your cloned voice.
#             Free. Needs a GPU, PulseAudio/PipeWire, and a signed-in Chrome.
#
#   attendee  The hosted Attendee service joins for you and streams the
#             transcript back. Barely touches this machine, but it is
#             LISTEN-ONLY and free for the first 5 hours only.
#
# Leave this on `auto` and the choice is made for you: set ATTENDEE below and
# you get the attendee backend, leave it blank and everything runs locally.
# Set `local` or `attendee` to force one regardless.
BOT_BACKEND=auto

# ─── Shared ──────────────────────────────────────────────────────────────────
# Name the bot shows up as in the meeting.
BOT_NAME=Decepticon

# Where transcripts are written. Both backends save one file per meeting.
TRANSCRIPTS_DIR=transcripts

# Google Calendar OAuth (download credentials.json from Google Cloud Console).
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# How often to check the calendar, and how far ahead to look.
POLL_INTERVAL_SEC=30
CALENDAR_LOOKAHEAD_MIN=1440

# Seconds before the scheduled start to join.
JOIN_EARLY_SEC=30

# ─── Local backend ───────────────────────────────────────────────────────────
# Local LLM that decides whether to speak, and what to say.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# Whisper size: tiny, base, small, medium. Larger is better but slower.
WHISPER_MODEL=small

# A clean WAV of your voice — this is what Chatterbox clones. Without it the
# bot still speaks, just not as you.
VOICE_REFERENCE_WAV=my_voice.wav

# Seconds of meeting audio per transcription pass. Lower is more responsive,
# higher is more accurate.
LISTEN_CHUNK_SEC=3.0

# Consecutive quiet chunks before assuming the meeting is over and leaving.
MAX_SILENT_CHUNKS=40

# Pause between unmuting and playing audio. Meet needs a moment to actually
# start transmitting; too low and the first words get clipped.
UNMUTE_SETTLE_SEC=0.6

# Chrome profile already signed in to the Google account with the calendar.
CHROME_PROFILE_DIR=/home/user/.config/google-chrome
CHROME_PROFILE_NAME=Default
CHROME_BINARY=/usr/bin/google-chrome

# Run Chrome without a visible window. Keep this false until joining works —
# the debug screenshots in /tmp are easier to interpret when you can watch too.
HEADLESS=false

# How the bot decides to speak. It must reply <SILENT> to stay quiet.
BOT_PERSONA=You are attending this Google Meet on behalf of the user. Be concise. Only respond when directly addressed or when you have something important to contribute. Keep responses under 3 sentences. If you don't need to say anything, reply with exactly: <SILENT>

# ─── Attendee backend ────────────────────────────────────────────────────────
# API key from app.attendee.dev. Setting this is all it takes to switch
# backends while BOT_BACKEND=auto.
ATTENDEE=

# Attendee pushes transcripts to a public HTTPS URL. Without one it still
# works — transcripts are fetched in one go after each meeting instead.
#   ngrok http 8765   then paste the https URL here
WEBHOOK_PUBLIC_URL=
WEBHOOK_PORT=8765

# How often to check whether the remote bot has left.
ATTENDEE_POLL_SEC=30
